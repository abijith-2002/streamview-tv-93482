<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Subtle drop shadow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000"/>
            <corners android:radius="@dimen/focus_outline_radius"/>
        </shape>
    </item>

    <!-- Primary colored outline -->
    <item android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent"/>
            <stroke
                android:width="@dimen/focus_outline_width"
                android:color="@color/op_primary"/>
            <corners android:radius="@dimen/focus_outline_radius"/>
        </shape>
    </item>
</layer-list>
