<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme for Android TV with Ocean Professional palette -->
    <!-- Use a Leanback theme to ensure LB widgets, attrs, and text appearances resolve -->
    <style name="AppTheme" parent="Theme.Leanback">
        <item name="android:windowBackground">@color/op_background</item>
        <item name="android:colorPrimary">@color/op_primary</item>
        <item name="android:colorAccent">@color/op_secondary</item>

        <!-- Safe references to our own top-level styles (no dotted names) -->
        <item name="browseTitleTextStyle">@style/OP_TitleTextStyle</item>
        <item name="rowHeaderStyle">@style/OP_RowHeaderStyle</item>
        <item name="searchOrbViewStyle">@style/OP_SearchOrb</item>
    </style>

    <!-- Local text appearance for headings used in app screens -->
    <style name="OP_TitleTextStyle">
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Local row header text style without inheriting from Leanback to avoid unresolved refs -->
    <style name="OP_RowHeaderStyle">
        <item name="android:textColor">@color/op_text</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!-- Local search orb view surrogate; uses supported attributes only -->
    <style name="OP_SearchOrb">
        <item name="android:background">@color/op_primary</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- Card title text: define locally without depending on Leanback text appearances -->
    <style name="OP_CardTitleText">
        <item name="android:textColor">@color/op_surface</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Backgrounds -->
    <style name="OP_BrowseFragmentBackground">
        <item name="android:background">@color/op_background</item>
    </style>
</resources>
